# Copy to .streamlit/secrets.toml locally, or into Community Cloud > App settings > Secrets.
# Values are placeholders. Never commit your real secrets.toml.
NEO4J_URI = "neo4j+ssc://YOUR_INSTANCE.databases.neo4j.io"
NEO4J_USER = "YOUR_USER"
NEO4J_PASSWORD = "YOUR_PASSWORD"
NEO4J_DATABASE = "YOUR_DATABASE"
