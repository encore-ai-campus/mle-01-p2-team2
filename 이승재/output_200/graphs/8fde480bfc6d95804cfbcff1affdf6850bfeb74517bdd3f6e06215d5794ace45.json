        "label": "Recipe",
        "properties": {
          "recipe_uid": "10000recipe_7081518",
          "title": "미소 된장국 레시피 팽이버섯과 산초를 넣은 간단한 일본식 된장국",
          "description": "오늘은 따뜻하고 담백하게 먹기 좋은 미소된장국을 끓여봤어요. 미소된장은 우리나라 된장과는 또 다른 부드럽고 구수한 맛이 있어서 간단한 국으로 끓여 먹기 좋아요. 오늘은 가쓰오부시 장국을 기본으로 미소된장을 풀고 팽이버섯과 쪽파를 넣어 간단하게 만들어봤어요. 마지막에 산초가루를 살짝 더해 은은한 향까지 더해주면 밥과 함께 먹기 좋은 미소된장국이 완성된답니다.",
          "servings": "2인분",
          "cooking_time": "20분 이내",
          "difficulty": "아무나",
          "views": 57,
          "source_url": "https://www.10000recipe.com/recipe/7081518",
          "source": "10000recipe"
        }
