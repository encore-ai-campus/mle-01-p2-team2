        "label": "Recipe",
        "properties": {
          "recipe_uid": "10000recipe_7080175",
          "title": "감자수제비",
          "description": "비 오는 날 특히 생각나는 국물 요리 중에 칼국수, 수제비 이런류의 음식이 생각나지요 특히 쫄깃하고 구수한 감자수제비!!는 못참지요. 직접 밀가루 반죽해서 수제비 만들면 좋겠지만 시판 감자수제비로 만들면 더 쫄깃하고 요리시간도 단축. 냉장고에 있는 채소 몇 가지만 꺼내 넣고 후다닥 끓여내면 밖에서 사먹는 느낌 못지않게 맛있더라고요. 무엇보다 국물이 진하고 구수해서 비 오는 날 창밖 보면서 먹기 딱 좋은 메뉴랍니다. 오늘은 간단한 재료로 쉽고 맛있게 끓이는 쫄깃한 감자수제비 레시피 소개해 볼게요 :)",
          "servings": "4인분",
          "cooking_time": "30분 이내",
          "difficulty": "아무나",
          "views": 90,
          "source_url": "https://www.10000recipe.com/recipe/7080175",
          "source": "10000recipe"
        }
