    "nodes": [
      {
        "id": "10000recipe_7081211",
        "label": "Recipe",
        "properties": {
          "recipe_uid": "10000recipe_7081211",
          "title": "다이어트 참치포케 만들기, 불 안쓰는 여배우 식단 샐러드 메뉴 레시피! 간장소스 포케 보울",
          "description": "오늘은 여배우 식단의 대명사. 여름 다이어트 음식 추천! 포케 맛있게 만들어 볼까요? 포케는 하와이어로 '자르다', '깍둑썰기하다' 는 뜻인데요, 생채소와 신선한 회 종류를 잘게 썰고, 소스에 버무려먹는 하와이 전통음식이에요. 여기에 밥을 얹으면 '포케보울'로 포만감이 오래가서 다이어트 메뉴로도 너무 좋더라고요. 연어, 새우, 닭가슴살, 스테이크 등 다양한 재료와 소스를 조합해 확장시킬 수 있고요, 생선회 대신에 참치캔을 활용하셔도 잘 어울려요. 다이어트 목적이 아니더라도 후레쉬한 야채를 골고루 먹을 수 있어서 여름에 드시면 참 좋을 한 그릇 요리랍니다. ​",
          "servings": "2인분",
          "cooking_time": "20분 이내",
          "difficulty": "아무나",
          "views": 184,
          "source_url": "https://www.10000recipe.com/recipe/7081211",
          "source": "10000recipe"
        }
      },
